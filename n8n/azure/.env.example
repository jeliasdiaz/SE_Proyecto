# Copia este archivo a .env (ignorado por Git) y pon la llave de API.
N8N_URL=https://n8n-request.chilecentral.cloudapp.azure.com
# n8n → Settings → n8n API → Create an API key. Con expiración corta: da control total de la instancia.
N8N_API_KEY=

# No son secretos. En Azure van escritos en los nodos porque las variables de la VM
# (que sigue teniendo el correo anterior en CORREO_REMITENTE) no se pueden cambiar sin acceso a Azure.
SUPABASE_URL=https://osrsevbvgrsqlkuvnzor.supabase.co
CORREO_REMITENTE="Gestión de Solicitudes <gestionsolicitudes.se@gmail.com>"
