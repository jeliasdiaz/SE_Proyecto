# Copia este archivo como .env (no se sube a Git) y completa los valores.

# Cifra las credenciales guardadas en n8n. Genera una con: openssl rand -hex 32
# Si la cambias, n8n ya no puede leer las credenciales guardadas en el volumen.
N8N_ENCRYPTION_KEY=

# Supabase local. La llave sale de `npx supabase status` (desde la raíz del repo), campo "Secret".
# Desde el contenedor de n8n la API se alcanza por la red de Supabase, no por 127.0.0.1.
SUPABASE_URL=http://supabase_kong_SE_Proyecto:8000
SUPABASE_SECRET_KEY=

# Encabezado que deben enviar los Database Webhooks de Supabase (#25) para que n8n los acepte.
# Genera uno con: openssl rand -hex 24
WEBHOOK_HEADER=x-webhook-secret
WEBHOOK_SECRET=

# SMTP de pruebas: el Mailpit de Supabase local (bandeja en http://127.0.0.1:54324).
SMTP_HOST=supabase_inbucket_SE_Proyecto
SMTP_PORT=1025
SMTP_REMITENTE="Solicitudes <solicitudes@solicitudes.test>"

# Buzón IMAP falso (GreenMail) al que escriben los estudiantes en F4.
BUZON_CORREO=solicitudes@solicitudes.test
BUZON_CLAVE=solicitudes

# URL de la web (Next.js): los correos enlazan a /mis-solicitudes/<id> y /admin/solicitudes/<id>.
APP_URL=http://localhost:3000

ZONA_HORARIA=America/Bogota
