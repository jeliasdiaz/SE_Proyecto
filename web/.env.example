# Copia este archivo como .env.local (no se sube a Git) y completa los valores.
#
# Supabase local: desde web/, `npx supabase status --workdir ..` muestra la URL y la llave publishable.
# Supabase en la nube: Dashboard > Project Settings > API Keys.
#
# Todo lo que empieza con NEXT_PUBLIC_ llega al navegador: aquí solo van valores públicos.
# La llave secreta (sb_secret_... o service_role) NUNCA va en este proyecto; solo en n8n.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
